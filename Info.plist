<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged over the generated Info.plist. The launch screen is one flat sky colour,
	     LaunchBackground; the app's first frame starts on that exact colour and fades the
	     clouds in, so launch and first frame read as one motion rather than a cut. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>colesherman.SundayScaries.refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>colesherman.SundayScaries</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sundayscaries</string>
			</array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
